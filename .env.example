# Copy to .env in the repo root ( .env is gitignored ).
# Used by: python scripts/train_fraud_model.py

# Use EITHER Option A OR Option B. Option B wins if SUPABASE_DB_HOST and SUPABASE_DB_PASSWORD are both set.

# --- Option A: full URI (password may contain @)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Option B: discrete fields (if URLs/DNS confuse copy-paste, use Host + password from Supabase dashboard)
# SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_PASSWORD
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
