# Copy to .env in the repo root ( .env is gitignored ).
# Used by: python scripts/train_fraud_model.py
#
# Shell env vars (e.g. DATABASE_URL in PowerShell) still win if set — .env does not override them.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional: same meaning as DATABASE_URL
# SUPABASE_DB_URL=
